APP_NAME=Institutional SMC AI Cloud
# Cloud release version is code-authoritative in app/config.py.
TIMEZONE_NAME=Africa/Lagos
CLOUD_EA_API_KEY=replace-with-a-long-random-secret
DB_PATH=/data/smc_cloud.db
PAPER_ONLY=true

# Existing intraday checkpoints.
SESSION_ANALYSIS_TIMES=07:50,12:50,15:20
# Deriv XAUUSD trades Sun 22:10-Fri 20:45 GMT, with Mon-Thu daily
# break 20:59-22:05 GMT. WAT is UTC+1, so run analysis one minute after
# the weekly/daily reopen to allow a fresh bridge snapshot.
TRADING_DAY_OPEN_TIME=23:06
TRADING_DAY_WEEKDAYS=0,1,2,3
WEEK_OPEN_WEEKDAY=6
WEEK_OPEN_TIME=23:11
SCHEDULER_POLL_SECONDS=20
PLAN_REFRESH_MINUTES=180

AI_ENABLED=true
REQUIRE_AI_FOR_EXECUTION=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=18
# Optional generic OpenAI-compatible provider fallback:
AI_COMPAT_URL=
AI_COMPAT_KEY=
AI_COMPAT_MODEL=

# V6.4 ML DATA FOUNDATION — collection and shadow labels only.
# No ML model is allowed to place a trade or change risk in V6.4.
ML_DATA_ENABLED=true
ML_MAX_CLOUD_ZONES_PER_ANALYSIS=24
ML_MAX_OPEN_CANDIDATES_PER_MARK=2500
ML_MAX_LABEL_HOURS=24
ML_DATASET_EXPORT_LIMIT=100000
ML_MIN_RESOLVED_FOR_TRAINING=1000

ZONE_RETIRE_TOUCH_COUNT=2
ZONE_MIN_INDEPENDENT_CONFLUENCES=2
ZONE_LIQUIDITY_ENVELOPE_MAX_H1_ATR=1.50
ZONE_LIQUIDITY_ENVELOPE_MAX_H4_ATR=0.75
ZONE_LIQUIDITY_ENVELOPE_MAX_D1_ATR=0.30
ZONE_LIQUIDITY_SWEEP_BUFFER_M15_ATR=0.15
CLEAR_RUN_WITH_TREND_PRICE=5.0
CLEAR_RUN_COUNTERTREND_PRICE=10.0

MAX_SNAPSHOT_AGE_SECONDS=120
MAX_SPREAD_POINTS=35
NEWS_ENTRY_LOCK_MINUTES=15
NEWS_POST_REVALIDATE_MINUTES=10

# v6.5.49 DEMO/PAPER grade-scaled validation risk.
RESEARCH_VALIDATION_INITIAL_CAPITAL=10000
RESEARCH_RISK_PCT_A_PLUS=1.00
RESEARCH_RISK_PCT_A=0.75
RESEARCH_RISK_PCT_B_PLUS=0.25
RESEARCH_RISK_EPOCH=RISK_NORMALIZED_10000_V1

M15_SINGLE_ACCEPT_BODY_FRACTION=0.60
M15_SINGLE_ACCEPT_BODY_ATR=0.40
M15_DOUBLE_ACCEPT_BODY_ATR=0.20

PROTOCOL_VERSION=6
TESTER_PLAN_FILENAME=SMC_v6_tester_plans.csv
