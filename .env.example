APP_ENV=production
DATABASE_PATH=/data/smc_cloud.db

# MT5/cloud authentication
CLOUD_EA_API_KEY=replace-with-long-random-key
ADMIN_API_KEY=replace-with-separate-long-random-key
SIGNING_SECRET=replace-with-long-random-signing-secret

# Multi-provider AI failover (first schema-valid provider wins)
AI_ENABLED=true
REQUIRE_AI_FOR_EXECUTION=true
AI_PROVIDER_ORDER=gemini,groq,openrouter,tensormux,openai
AI_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=90

# Gemini direct (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq direct (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (optional; choose a model in your account)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# TensorMux gateway (optional; OpenAI-compatible endpoint)
TENSORMUX_API_KEY=
TENSORMUX_MODEL=
TENSORMUX_BASE_URL=

# OpenAI direct fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Safety / execution context
PAPER_ONLY=true
TIMEZONE_NAME=Africa/Lagos
MAX_SNAPSHOT_AGE_SECONDS=900
PLAN_VALID_MINUTES=120
MAX_SPREAD_POINTS=40
BPLUS_EXECUTABLE=false
XAU_PIP_SIZE=0.01
MIN_CLEAR_RUN_WITH_TREND_PIPS=50
MIN_CLEAR_RUN_COUNTER_TREND_PIPS=100

# Trading style: D1/DXY = context; H4/H1 = primary institutional zones; M15 = one-time zone qualification; M1 = execution
TRADING_PROFILE=INTRADAY_HTF_ZONE_M1
INTRADAY_MAX_DISTANCE_H1_ATR=2.5
INTRADAY_MAX_DISTANCE_D1_ATR=0.35
INTRADAY_MAX_ZONE_WIDTH_M15_ATR=2.5
INTRADAY_H1_LOOKBACK=180
INTRADAY_M15_LOOKBACK=320
INTRADAY_MAX_CANDIDATES=8

# Request replay protection
NONCE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# Session orchestration - configure to your broker/workflow
SESSION_ASIA_START=00:00
SESSION_LONDON_START=08:00
SESSION_NEWYORK_START=13:00
SESSION_LEAD_MINUTES=10
SCHEDULER_POLL_SECONDS=20
SESSION_CATCHUP_MINUTES=20
SESSION_ACTIVE_RECOVERY=true
SESSION_SNAPSHOT_MAX_AGE_SECONDS=180

# Historical context protocol v3.6.1
HISTORY_FULL_MAX_AGE_HOURS=12
HISTORY_MIN_XAU_D1=240
HISTORY_MIN_XAU_H4=480
HISTORY_MIN_XAU_H1=400
HISTORY_MIN_XAU_M15=400
HISTORY_MIN_DXY_D1=200
HISTORY_MIN_DXY_H4=480
HISTORY_MIN_DXY_H1=400
HISTORY_MERGE_CAP_D1=320
HISTORY_MERGE_CAP_H4=700
HISTORY_MERGE_CAP_H1=700
HISTORY_MERGE_CAP_M15=560
SNAPSHOT_LIVE_RETENTION=1500
SNAPSHOT_FULL_RETENTION=180

# News: mt5_calendar (recommended), manual, or tradingeconomics
NEWS_PROVIDER=mt5_calendar
TRADINGECONOMICS_API_KEY=
NEWS_POLL_MINUTES=10

# Every high-impact USD release gets a deep H4/H1 zone revalidation at T-10 and T+10.
NEWS_PRE_ANALYSIS_MINUTES=10
NEWS_POST_ANALYSIS_MINUTES=10
PRE_NEWS_CATCHUP_MINUTES=9
POST_NEWS_CATCHUP_MINUTES=30

# New M1 entries are locked from T-10 until T+10. Existing demo positions
# continue deterministic SL / break-even / trailing management; stops never loosen.
NEWS_PRE_BLACKOUT_MINUTES=10
NEWS_POST_COOLDOWN_MINUTES=10

DASHBOARD_ENABLED=true
